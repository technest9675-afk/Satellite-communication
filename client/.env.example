# NEXUS Client Environment Configuration Example
# If your backend is hosted separately (e.g., Render, Railway, Fly.io):
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_SOCKET_URL=https://api.yourdomain.com

# For local development, leave these blank to default to Vite's local proxy (http://localhost:5000)
VITE_API_BASE_URL=
VITE_SOCKET_URL=
